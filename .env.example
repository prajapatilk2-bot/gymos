# Copy this file to .env and fill in real values for local development.
# Never commit .env with real secrets.

# PostgreSQL connection string (Neon in production, local Postgres in dev).
DATABASE_URL="postgresql://gymos:gymos_dev_pw@localhost:5432/gymos"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Session inactivity auto-logout, in minutes (W3). Also configurable per
# organization via OrganizationSetting key "session.inactivityTimeoutMinutes".
SESSION_INACTIVITY_TIMEOUT_MINUTES="30"

# Seed script — super admin credentials for the demo organization.
SEED_ADMIN_EMAIL="admin@gymos.test"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
